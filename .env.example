# Copy this file to ".env" and fill in the values. ".env" is git-ignored: NEVER commit it or paste it in chat.
# Docker passes these to the dev container automatically (compose.yaml).

# --- Sepolia test network (only needed for `npm run deploy:sepolia`) ---
# Free public RPC, no account needed:
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Private key of a NEW MetaMask account used ONLY for testing, funded with free Sepolia test ETH.
# MetaMask: account menu -> Account details -> Show private key. Starts with 0x.
SEPOLIA_PRIVATE_KEY=

# --- Cloudflare Pages hosting (only needed for `npm run pages:deploy`) ---
# Dashboard -> My Profile -> API Tokens -> Create Token -> template "Edit Cloudflare Workers".
CLOUDFLARE_API_TOKEN=
# Dashboard home page, right-hand side: "Account ID".
CLOUDFLARE_ACCOUNT_ID=
